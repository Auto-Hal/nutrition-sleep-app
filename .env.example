SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
DATABASE_URL=postgresql://postgres:replace_me@db.your-project.supabase.co:5432/postgres
APP_SESSION_ENCRYPTION_KEY=replace_with_32_byte_base64url_key

