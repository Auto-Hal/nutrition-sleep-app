# Server-only values. Do not prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
DATABASE_URL=postgresql://postgres:replace_me@db.your-project.supabase.co:5432/postgres
APP_SESSION_ENCRYPTION_KEY=replace_with_32_byte_base64url_key
APP_ALLOWED_USER_ID=00000000-0000-4000-8000-000000000001
APP_LOGIN_RATE_LIMIT_KEY=replace_with_32_byte_base64url_rate_limit_key
PROVIDER_TOKEN_ENCRYPTION_KEY=replace_with_separate_32_byte_provider_token_key

# Used only for local/test safeguards and callback allow-listing.
APP_ORIGIN=http://localhost:3000
EXPECTED_SUPABASE_PROJECT_REF=replace_me
